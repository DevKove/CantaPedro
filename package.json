{
  "name": "cantapedro",
  "version": "1.1.1",
  "private": true,
  "description": "Karaoke desktop offline para Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.cantapedro.desktop",
    "productName": "CantaPedro",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["index.html","styles.css","app.js","manifest.webmanifest","sw.js","electron/**/*","package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "CantaPedro" }
  }
}