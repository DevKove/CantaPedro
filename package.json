{
  "name": "cantapedro",
  "version": "1.1.7",
  "private": true,
  "description": "Karaoke desktop offline para Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run prepare:audio && electron .",
    "dist": "npm run prepare:audio && electron-builder --win nsis --publish never",
    "dist:win": "npm run prepare:audio && electron-builder --win nsis --publish never",
    "prepare:audio": "node scripts/prepare-audio.mjs",
    "test": "node --test",
    "check": "node --check app.js && node --check midi-parser.js && node --check audio-engine.js && node --check electron/main.cjs && node --check electron/preload.cjs && node --check scripts/prepare-audio.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "br.com.cantapedro.desktop",
    "productName": "CantaPedro",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "midi-parser.js",
      "audio-engine.js",
      "assets/**/*",
      "vendor/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CantaPedro",
      "artifactName": "CantaPedro.Setup.${version}.${ext}"
    }
  },
  "dependencies": {
    "spessasynth_core": "4.4.8",
    "spessasynth_lib": "4.4.5"
  },
  "type": "module"
}
